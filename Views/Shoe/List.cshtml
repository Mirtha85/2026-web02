@using LuxeStep.ViewModels
@model ShoeListViewModel

<h1 class="page-title">@Model.CurrentCategory</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var shoe in Model.Shoes)
    {
        <div class="col">
            <div class="card shoe-card">
                <div class="shoe-img-wrapper">
                    @if (!string.IsNullOrEmpty(shoe.ImageThumbnailUrl))
                    {
                        <img src="@shoe.ImageThumbnailUrl" class="card-img-top" alt="@shoe.Name">
                    }
                    else
                    {
                        <div class="shoe-img-placeholder">
                            <span>👟</span>
                        </div>
                    }
                    @if (shoe.IsShoeOfTheWeek)
                    {
                        <span class="badge-week">⭐ Destacado</span>
                    }
                </div>
                <div class="card-body shoe-body">
                    <div class="shoe-brand">@shoe.Brand</div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <h2 class="shoe-name">
                            <a class="shoe-link">@shoe.Name</a>
                        </h2>
                        <h5 class="shoe-price">@shoe.Price.ToString("c")</h5>
                    </div>
                    <p class="shoe-desc">@shoe.ShortDescription</p>
                    <div class="shoe-meta">
                        <span class="badge-gender">@shoe.Gender</span>
                        <span class="badge-category">@shoe.Category.CategoryName</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
