@model LuxeStep.Models.Cliente

@{
    ViewData["Title"] = "Registro de Cliente";
}

<div class="cart-page">
    <div class="cart-header">
        <h1 class="cart-title">Registro de Cliente</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="cart-summary-box">
                <h2 class="summary-title">Nuevo Cliente</h2>
                
                <form asp-action="Create" method="post" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Nombre" class="summary-label mb-2"></label>
                        <input asp-for="Nombre" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Juan Pérez" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Correo" class="summary-label mb-2"></label>
                        <input asp-for="Correo" type="email" class="form-control bg-dark text-white border-secondary" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Telefono" class="summary-label mb-2"></label>
                        <input asp-for="Telefono" class="form-control bg-dark text-white border-secondary" placeholder="+591 ..." />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FechaNacimiento" class="summary-label mb-2"></label>
                        <input asp-for="FechaNacimiento" type="date" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn-checkout border-0">
                            Registrar Cliente
                        </button>
                        <a asp-action="Index" class="btn btn-back text-center">
                            Ver Listado
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
